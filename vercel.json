{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://api.stripe.com https://*.stripe.com; frame-src https://js.stripe.com https://checkout.stripe.com; form-action 'self' https://checkout.stripe.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self), payment=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/learn",
      "destination": "/api/seo-page?path=/learn"
    },
    {
      "source": "/nominate-a-pro",
      "destination": "/api/seo-page?path=/nominate-a-pro"
    },
    {
      "source": "/hair-tips",
      "destination": "/api/seo-page?path=/hair-tips"
    },
    {
      "source": "/hair-tips/:slug",
      "destination": "/api/seo-page?section=hair-tips&slug=:slug"
    },
    {
      "source": "/pro/:slug",
      "destination": "/api/seo-page?path=/pro/:slug"
    },
    {
      "source": "/barbers/:city",
      "destination": "/api/seo-page?path=/barbers/:city"
    },
    {
      "source": "/hairstylists/:city",
      "destination": "/api/seo-page?path=/hairstylists/:city"
    },
    {
      "source": "/colourists/:city",
      "destination": "/api/seo-page?path=/colourists/:city"
    },
    {
      "source": "/balayage/:city",
      "destination": "/api/seo-page?path=/balayage/:city"
    },
    {
      "source": "/beard-grooming/:city",
      "destination": "/api/seo-page?path=/beard-grooming/:city"
    },
    {
      "source": "/curly-hair/:city",
      "destination": "/api/seo-page?path=/curly-hair/:city"
    },
    {
      "source": "/fine-hair/:city",
      "destination": "/api/seo-page?path=/fine-hair/:city"
    },
    {
      "source": "/beard-trim/:city",
      "destination": "/api/seo-page?path=/beard-trim/:city"
    },
    {
      "source": "/fades/:city",
      "destination": "/api/seo-page?path=/fades/:city"
    },
    {
      "source": "/hair-extensions/:city",
      "destination": "/api/seo-page?path=/hair-extensions/:city"
    },
    {
      "source": "/barber-reviews/:city",
      "destination": "/api/seo-page?path=/barber-reviews/:city"
    },
    {
      "source": "/hairstylist-reviews/:city",
      "destination": "/api/seo-page?path=/hairstylist-reviews/:city"
    },
    {
      "source": "/colourist-reviews/:city",
      "destination": "/api/seo-page?path=/colourist-reviews/:city"
    },
    {
      "source": "/best-barbers/:city",
      "destination": "/api/seo-page?path=/best-barbers/:city"
    },
    {
      "source": "/top-colourists/:city",
      "destination": "/api/seo-page?path=/top-colourists/:city"
    },
    {
      "source": "/invite/:token",
      "destination": "/index.html"
    },
    {
      "source": "/help/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/policies/:slug",
      "destination": "/index.html"
    }
  ]
}
