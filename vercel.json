{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/invite/:token",
      "destination": "/index.html"
    },
    {
      "source": "/help/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/policies/:slug",
      "destination": "/index.html"
    }
  ]
}
